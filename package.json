{
  "name": "sccam-library",
  "version": "1.0.0",
  "private": true,
  "description": "Unofficial community library for the international commercial arbitration moot (SCCAM). Not affiliated with the organizers.",
  "scripts": {
    "dev": "node scripts/copy-pdf-worker.mjs && next dev",
    "build": "node scripts/copy-pdf-worker.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -rf data/app.db data/uploads && npm run db:seed",
    "postinstall": "node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@libsql/client": "0.18.0",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "mammoth": "1.13.0",
    "next": "15.5.29",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "qrcode": "1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.24.1",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.9.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "sharp": "^0.35.5",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
}
