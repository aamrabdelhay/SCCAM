# ── Database ────────────────────────────────────────────────────────────────
# Local development needs no configuration: SQLite file at ./data/app.db
# Production (Turso free tier): create a database and paste the libsql URL + token
# DATABASE_URL="libsql://<db>-<org>.turso.io"
# DATABASE_AUTH_TOKEN="..."
# Optional local override:
# LOCAL_DB_PATH="./data/app.db"

# ── Auth ────────────────────────────────────────────────────────────────────
# 32+ random characters. Used to sign the admin session cookie and file-access cookies.
# Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

# ── File storage ────────────────────────────────────────────────────────────
# Local dev stores uploads under ./data/uploads.
# Production: Vercel Blob (private store) — create it in the Vercel dashboard.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Site ────────────────────────────────────────────────────────────────────
# Absolute public URL used in citations, QR codes and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── OCR (optional) ──────────────────────────────────────────────────────────
# Server-side OCR needs `tesseract.js` + `@napi-rs/canvas` installed and
# traineddata reachable. When unavailable, admin reviews text per page instead.
# OCR_ENABLED="false"
